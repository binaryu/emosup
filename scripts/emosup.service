[Unit]
Description=emosup — OpenList / local media → Emos upload panel
Documentation=https://github.com/binaryu/emosup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/emosup
ExecStart=/opt/emosup/emosup-server
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

# All EMOSUP_* variables come from /opt/emosup/emosup.env (created by
# install.sh). Do NOT hardcode Environment= here: systemd gives it priority
# over EnvironmentFile, which would silently ignore edits to emosup.env.
EnvironmentFile=-/opt/emosup/emosup.env

# Uncomment to run as non-root (create user first):
# User=emosup
# Group=emosup

[Install]
WantedBy=multi-user.target
